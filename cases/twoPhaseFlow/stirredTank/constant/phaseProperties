FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases (gas liquid);

gas
{
    diameterModel   isothermal;
    isothermalCoeffs
    {
        d0              3e-3;
        p0              101325;
    }

    residualAlpha   1e-6;
}

liquid
{
    diameterModel   constant;
    constantCoeffs
    {
        d               1e-4;
    }

    residualAlpha   1e-6;
}

blending
{
    default
    {
        type            linear;
        maxFullyDispersedAlpha.gas 0.3;
        maxPartlyDispersedAlpha.gas 0.5;
        maxFullyDispersedAlpha.liquid 0.3;
        maxPartlyDispersedAlpha.liquid 0.5;
    }

    heatTransfer
    {
        type            linear;
        maxFullyDispersedAlpha.gas 0.3;
        maxPartlyDispersedAlpha.gas 0.7;
        maxFullyDispersedAlpha.liquid 0.3;
        maxPartlyDispersedAlpha.liquid 0.7;
    }
}

sigma
(
    (gas and liquid)     0.072
);

aspectRatio
(
    (gas in liquid)
    {
        type            constant;
        E0              1.0;
    }

    (liquid in gas)
    {
        type            constant;
        E0              1.0;
    }
);

drag
(
    (gas in liquid)
    {
        type            IshiiZuber;
        residualRe      1e-3;
        swarmCorrection
        {
            type            none;
            residualAlpha   Tomiyama;
            l               1.75;
        }
    }

    (liquid in gas)
    {
        type            SchillerNaumann;
        residualRe      1e-3;
        swarmCorrection
        {
            type        none;
        }
    }

    (gas and liquid)
    {
        type            segregated;
        m               0.5;
        n               8;
        swarmCorrection
        {
            type        none;
        }
    }
);

virtualMass
(
    (gas in liquid)
    {
        type            constantCoefficient;
        Cvm             0.5;
    }

    (liquid in gas)
    {
        type            constantCoefficient;
        Cvm             0.5;
    }
);

heatTransfer
(
    (gas in liquid)
    {
        type            RanzMarshall;
        residualAlpha   1e-4;
    }

    (liquid in gas)
    {
        type            RanzMarshall;
        residualAlpha   1e-4;
    }
);


lift
(
    (gas in liquid)
    {
        type constantCoefficient;
        Cl   0.25;
    }

    (liquid in gas)
    {
        type none;
    }
);

wallLubrication
(
);

turbulentDispersion
(
);

// Minimum allowable pressure
pMin            10000;


