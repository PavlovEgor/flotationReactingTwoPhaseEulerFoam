FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.air 1.0
    volScalarFieldValue alpha.water 0.0
);

regions
(
    boxToCell
    {
        box (-0.21 -0.2 -0.21) (0.21 0.08 0.21);
        fieldValues
        (
                volScalarFieldValue alpha.air 0.04
                volScalarFieldValue alpha.water 0.96
        );
    }
);


