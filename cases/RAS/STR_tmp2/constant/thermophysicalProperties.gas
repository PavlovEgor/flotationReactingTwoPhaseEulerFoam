FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         multiComponentMixture;
    transport       const;
    thermo          eConst;
    equationOfState perfectFluid;
    specie          specie;
    energy          sensibleInternalEnergy;
}

species
(
    air
    particle
);

inertSpecie air;

air
{
    specie
    {
        molWeight   28.9;
    }
    equationOfState
    {
        R           286;
        rho0        0.01;
    }
    thermodynamics
    {
        Hf          0;
        Cv          724.8;
    }
    transport
    {
        mu          1.84e-05;
        Pr          0.7;
    }
}

particle
{
    specie
    {
        molWeight   177014728800000.0;
    }
    thermodynamics
    {
        Hf          0;
        Cv          100.3;
    }
    transport
    {
        mu          1.84e-05;
        Pr          0.7;
    }
    equationOfState
    {
        R           1e8;
        rho0        2600;
    }
}


