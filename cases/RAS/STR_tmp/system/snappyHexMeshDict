FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    // impeller
    // {
    //     type triSurfaceMesh;
    //     file "impeller.stl";
    // }
    vessel
    {
        type triSurfaceMesh;
        file "vessel.stl";
    }
    //- Used to define MRF zone and refine mesh round the impeller 
    MRF
    {
        type searchableCylinder;
        point1 (0.0 -0.017 0.0);
        point2 (0.0  0.017 0.0);
        radius 0.05;
    }

    baffle1
    {
        type triSurfaceMesh;
        file "baffle1_s.stl";
    }
    baffle2
    {
        type triSurfaceMesh;
        file "baffle2_s.stl";
    }
    baffle3
    {
        type triSurfaceMesh;
        file "baffle3_s.stl";
    }
    baffle4
    {
        type triSurfaceMesh;
        file "baffle4_s.stl";
    }

    blade1
    {
        type triSurfaceMesh;
        file "blade1_s.stl";
    }  
    blade2
    {
        type triSurfaceMesh;
        file "blade2_s.stl";
    }  
    blade3
    {
        type triSurfaceMesh;
        file "blade3_s.stl";
    }  
    blade4
    {
        type triSurfaceMesh;
        file "blade4_s.stl";
    }  
    blade5
    {
        type triSurfaceMesh;
        file "blade5_s.stl";
    }  
    blade6
    {
        type triSurfaceMesh;
        file "blade6_s.stl";
    }  
    blade_base
    {
        type triSurfaceMesh;
        file "blade_base_s.stl";
    } 

	StaticBlade1
	{
		type searchableCylinder;
		point1 (0.1 -0.065 0);
		point2 (0.1 0.13 0);
		radius 0.03;
	}
	StaticBlade2
	{
		type searchableCylinder;
		point1 (-0.1 -0.065 0);
		point2 (-0.1 0.13 0);
		radius 0.03;
	}
	StaticBlade3
	{
		type searchableCylinder;
		point1 (0 -0.065 0.1);
		point2 (0 0.13 0.1);
		radius 0.03;
	}
	StaticBlade4
	{
		type searchableCylinder;
		point1 (0 -0.065 -0.1);
		point2 (0 0.13 -0.1);
		radius 0.03;
	}
}


castellatedMeshControls
{

    maxLocalCells 100000;

    maxGlobalCells 2000000;

    minRefinementCells 0;

    nCellsBetweenLevels 5;

    maxLoadUnbalance 0.10;

    features
    (
        {
            file "vessel.eMesh";
            level 0;
        }

        // {
        //     file "impeller.eMesh";
        //     level 1;
        // }

    );

    resolveFeatureAngle 30;

    refinementSurfaces
    {
        MRF
        {
            level (1 1);
            cellZone cellMRFzone;
            faceZone faceMRFzone;
            cellZoneInside inside;
        }

        // impeller
        // {
        //     level (1 1);
        // }

        vessel
        {
            level (0 0);
        }
        baffle1
        {
            level (0 0);
        }
        baffle2
        {
            level (0 0);
        }
        baffle3
        {
            level (0 0);
        }
        baffle4
        {
            level (0 0);
        }
    blade1
    {
        level (2 2);
    }  
    blade2
    {
        level (2 2);
    }  
    blade3
    {
        level (2 2);
    }  
    blade4
    {
        level (2 2);
    }  
    blade5
    {
        level (2 2);
    }  
    blade6
    {
        level (2 2);
    }  
    blade_base
    {
        level (2 2);
    } 
    }

    refinementRegions
    {
        MRF
        {
            mode inside;
            levels ((1E15 1));
        }
        StaticBlade1
        {
            mode inside;
            levels ((1E15 1));
        }
        StaticBlade2
        {
            mode inside;
            levels ((1E15 1));
        }
        StaticBlade3
        {
            mode inside;
            levels ((1E15 1));
        }
        StaticBlade4
        {
            mode inside;
            levels ((1E15 1));
        }
    }

    locationInMesh (0.0 0.1 0.0); // Inside point

    allowFreeStandingZoneFaces true;
}

// Settings for the snapping.
snapControls
{

    nSmoothPatch 3;

    tolerance 1.0;

    nSolveIter 300;

    nRelaxIter 10;

    nFeatureSnapIter 10;

    implicitFeatureSnap true;

    explicitFeatureSnap false;

    multiRegionFeatureSnap true;
}

// Settings for the layer addition.
addLayersControls
{

    relativeSizes true;

    layers
    {
    }

    expansionRatio 1.0;

    finalLayerThickness 0.3;

    minThickness 0.25;

    nGrow 0;

    featureAngle 30;

    nRelaxIter 5;

    nSmoothSurfaceNormals 1;

    nSmoothNormals 3;

    nSmoothThickness 10;

    maxFaceThicknessRatio 0.5;

    maxThicknessToMedialRatio 0.3;

    minMedianAxisAngle 90;

    nBufferCellsNoExtrude 0;

    nLayerIter 50;

    nRelaxedIter 20;
}

meshQualityControls
{
    #include "meshQualityDict"

    relaxed
    {
        maxNonOrtho 75;
    }
}

writeFlags
(
);

mergeTolerance 1E-6;


