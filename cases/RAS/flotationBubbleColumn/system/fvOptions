FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

injector1
{
    timeStart       0.0;
    duration        1000;
    selectionMode   cellSet;
    cellSet         injection1;
}

injector2
{
    timeStart       0.0;
    duration        1000;
    selectionMode   cellSet;
    cellSet         injection2;
}

options
{
    massSource1
    {
        type            scalarSemiImplicitSource;

        $injector1;

        volumeMode      absolute;
        injectionRateSuSp
        {
            thermo:rho.gas     (0.00013 0); // kg/s
        }
    }

